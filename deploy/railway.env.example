# Set these as Railway service/shared variables, not VITE_* variables.
APP_NAME="African Ranked"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://african-ranked-web-app-production.up.railway.app
APP_PREVIEW=false
APP_REVIEW=false
# Keep indexing disabled until the custom domain and explicit search launch approval.
SEO_INDEXING_ENABLED=false
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_ROLE=web

DB_CONNECTION=pgsql
# In Railway, reference the PostgreSQL service's private DATABASE_URL here.
DB_URL=
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SESSION_COOKIE=african_ranked
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180

STAFF_REQUIRE_ADMIN_2FA=true
APP_TRUSTED_HOSTS=
EDITORIAL_LEGACY_PREVIEW=false
EDITORIAL_TIMEZONE=Africa/Nairobi
CMS_IMPORT_OWNER_EMAIL=

LOG_CHANNEL=stderr
LOG_LEVEL=warning
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=YOUR_VERIFIED_MAIL_PROVIDER
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=YOUR_VERIFIED_FROM_ADDRESS
MAIL_FROM_NAME="African Ranked"
OPENSEO_API_KEY=
OPENSEO_PROJECT_ID=61feee07-a792-4ac8-a675-bf4aa842c222
OPENSEO_LOCATION_CODE=2840
GEMINI_API_KEY=
GEMINI_SEO_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_ARTICLE_MODEL=gpt-5-mini
