# Apply to web, worker and scheduler after custom-domain and launch acceptance.
# Retain the existing APP_KEY, DB_URL and private provider credentials.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR_VERIFIED_CUSTOM_DOMAIN
# Keep these true while reviewing on Railway; disable only for the approved launch.
APP_PREVIEW=true
APP_REVIEW=true
EDITORIAL_LEGACY_PREVIEW=false
LAUNCH_ARTICLE_TARGET=19
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
STAFF_REQUIRE_ADMIN_2FA=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
# Configure a real verified mail transport before invitation/recovery inbox acceptance.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="African Ranked"
