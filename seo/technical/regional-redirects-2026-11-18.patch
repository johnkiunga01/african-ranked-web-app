@@ -0,0 +1,21 @@
+<?php
+
+namespace Tests\Feature;
+
+use Tests\TestCase;
+
+class RegionalRedirectsTest extends TestCase
+{
+    public function test_pages_without_regional_editions_redirect_to_the_global_page(): void
+    {
+        $this->get('/us/plan-safari')->assertStatus(301)->assertRedirect('/plan-safari');
+        $this->get('/ke/about')->assertStatus(301)->assertRedirect('/about');
+        $this->get('/uk/pages/privacy-policy')->assertStatus(301)->assertRedirect('/pages/privacy-policy');
+    }
+
+    public function test_regional_pages_that_exist_are_not_redirected(): void
+    {
+        $this->get('/us/rankings')->assertOk();
+        $this->get('/us/strategy')->assertOk();
+    }
+}
